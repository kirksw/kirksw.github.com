---
import type { Post } from '../lib/posts';
import { excerpt, postUrl, readingTime } from '../lib/posts';
const { post } = Astro.props as { post: Post };
---
<article class="post-card">
  <div class="post-card-date"><time datetime={post.data.date.toISOString()}>{post.data.date.toISOString().slice(0, 10)}</time><span>{readingTime(post.body)} min read</span></div>
  {post.data.draft && <span class="draft-label">Draft / local preview</span>}
  <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
  <p>{excerpt(post)}</p>
  <div class="post-card-meta">{post.data.tags.map((tag: string) => <a href={`/tags/${tag}/`}>#{tag}</a>)}</div>
</article>
