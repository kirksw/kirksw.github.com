---
import Layout from '../components/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts, terms } from '../lib/posts';
const posts = await allPosts();
const topics = terms(posts, 'tags');
---
<Layout title="Systems Journal" description="Kirk Sweeney writes about data engineering, software, and systems.">
  <section class="hero">
    <div>
      <p class="eyebrow">Systems Journal / Kirk Sweeney</p>
      <h1>Data solutions for a modern world.</h1>
      <p class="hero-lede">Notes from building data platforms and software: practical patterns, sharp edges, and things worth learning in public.</p>
      <div class="buttons"><a class="button" href="/posts/">Read the writing</a><a class="button" href="/about/">About Kirk</a></div>
    </div>
    <aside class="hero-aside"><p class="eyebrow">Current focus</p><p>Data platforms, engineering, software development, and DevOps workflows.</p><p><a href="/projects/">See the projects →</a></p></aside>
  </section>
  <section aria-labelledby="recent-heading">
    <div class="section-heading"><h2 id="recent-heading">Recent writing</h2><a href="/posts/">All posts →</a></div>
    <div class="post-list">{posts.slice(0, 4).map((post) => <PostCard post={post} />)}</div>
  </section>
  <section aria-labelledby="topics-heading">
    <div class="section-heading"><h2 id="topics-heading">Topics</h2><a href="/tags/">Browse all →</a></div>
    <ul class="topic-list">{topics.map((topic) => <li><a href={`/tags/${topic}/`}>{topic}</a></li>)}</ul>
  </section>
</Layout>
