---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/site.css';
interface Props { title?: string; description?: string; type?: string; }
const { title = 'Kirk Sweeney', description = 'Notes on data engineering, software, and systems.', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Kirk Sweeney</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/logo.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <script is:inline>
      let saved;
      try {
        saved = localStorage.getItem('theme');
      } catch {}
      const theme = saved === 'dark' || saved === 'light' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main class="main" id="main-content"><slot /></main>
    <Footer />

  </body>
</html>
