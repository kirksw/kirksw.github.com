---
import Layout from '../../components/Layout.astro';
import { allPosts, terms } from '../../lib/posts';
const tags = terms(await allPosts(), 'tags');
---
<Layout title="Topics"><header class="page-header"><p class="eyebrow">Index</p><h1>Topics</h1></header><ul class="terms-tags">{tags.map((tag) => <li><a href={`/tags/${tag}/`}>{tag}</a></li>)}</ul></Layout>
