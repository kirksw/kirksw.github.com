---
const links = [
  ['/posts/', 'Writing'], ['/about/', 'About'], ['/projects/', 'Projects'],
  ['/tags/', 'Topics'], ['/search/', 'Search'],
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <nav class="nav shell" aria-label="Main navigation">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">KS</span><span>Kirk Sweeney</span></a>
    <div class="nav-links">
      {links.map(([href, label]) => <a href={href} aria-current={path === href ? 'page' : path.startsWith(href) ? 'location' : undefined}>{label}</a>)}
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Use dark theme" aria-pressed="false"><span aria-hidden="true">◐</span><span class="theme-label">Theme</span></button>
    </div>
  </nav>
</header>
<script is:inline>
  const button = document.querySelector('#theme-toggle');
  const updateTheme = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    button?.setAttribute('aria-pressed', String(dark));
    button?.setAttribute('aria-label', dark ? 'Use light theme' : 'Use dark theme');
  };
  button?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    updateTheme();
  });
  updateTheme();
</script>
